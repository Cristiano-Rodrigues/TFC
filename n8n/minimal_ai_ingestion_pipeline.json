    {
      "id": "0d6a7606-eed0-44ba-96cd-804369a9ec41",
      "name": "Chunking Node",
      "parameters": {
        "jsCode": "const text = $json.text || '';\\nconst webhookData = $('Upload webhook').first().json || {};\\nconst document_id = webhookData.body?.document_id || webhookData.document_id || null;\\nconst filename = webhookData.body?.filename || webhookData.filename || 'Desconhecido';\\n\\nconst size = 500;\\nconst overlap = 100;\\nconst step = size - overlap;\\nlet chunks = [];\\n\\nif (text.length === 0) return chunks;\\n\\nfor (let i = 0; i < text.length; i += step) {\\n  chunks.push({\\n    pageContent: text.slice(i, i + size),\\n    document_id: document_id,\\n    metadata: {\\n      filename: filename\\n    }\\n  });\\n  \\n  if (i + size >= text.length) break;\\n}\\n\\nreturn chunks;"
      },
