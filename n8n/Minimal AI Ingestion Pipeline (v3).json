    {
      "parameters": {
        "jsCode": "let text = '';\nlet document_id = null;\nlet filename = 'Desconhecido';\n\ntry {\n  // Attempt to read from Upload Webhook\n  const webhookData = $('Upload webhook').first().json || {};\n  document_id = webhookData.body?.document_id || webhookData.document_id || null;\n  filename = webhookData.body?.filename || webhookData.filename || 'Desconhecido';\n  text = $json.text || '';\n} catch(e) {\n  // If Upload webhook didn't execute, it throws an error. We catch it and handle Slack Webhook path\n  document_id = $json.id || null; \n  filename = $json.filename || 'Desconhecido';\n  \n  try {\n     text = $(\"Extractor Chain\").item.json.content || '';\n  } catch(e2) {\n     text = '';\n  }\n}\n\nif (!text || text.length === 0) return [];\n\nfunction smartChunk(text, maxSize, overlapSize) {\n    const chunks = [];\n    // 1. Separar por parágrafos duplos\n    let parts = text.split(/(?:\\n\\n+)/);\n    \n    function splitAndAdd(str) {\n        if (str.length <= maxSize) return [str];\n        // 2. Se o parágrafo for gigante, separar por quebras de linha simples\n        let subParts = str.split(/(?<=\\n)/);\n        // 3. Se ainda for gigante, separar por pontos (frases)\n        if (subParts.length === 1) subParts = str.split(/(?<=\\. )/);\n        // 4. Se não houver pontos, corte estrito\n        if (subParts.length === 1) {\n            subParts = [];\n            for (let i = 0; i < str.length; i += maxSize) {\n                subParts.push(str.slice(i, i + maxSize));\n            }\n        }\n        \n        let result = [];\n        let current = \"\";\n        for (let p of subParts) {\n            if (current.length + p.length > maxSize && current.length > 0) {\n                result.push(current);\n                current = p;\n            } else {\n                current += p;\n            }\n        }\n        if (current) result.push(current);\n        return result;\n    }\n\n    let allParts = [];\n    for (let p of parts) {\n        // Garantir que as quebras de parágrafo são mantidas no texto final\n        allParts.push(...splitAndAdd(p + \"\\n\\n\"));\n    }\n\n    let currentChunk = \"\";\n    for (let i = 0; i < allParts.length; i++) {\n        let p = allParts[i];\n        if (currentChunk.length + p.length > maxSize && currentChunk.length > 0) {\n            chunks.push(currentChunk.trim());\n            \n            // Criar o overlap inteligente (tentar não cortar palavras a meio)\n            let overlapText = currentChunk.slice(-overlapSize);\n            let spaceIdx = overlapText.indexOf(' ');\n            if (spaceIdx !== -1) {\n                overlapText = overlapText.slice(spaceIdx + 1);\n            }\n            currentChunk = overlapText + (overlapText && p && !overlapText.endsWith(' ') && !p.startsWith(' ') ? ' ' : '') + p;\n        } else {\n            currentChunk += p;\n        }\n    }\n    \n    if (currentChunk.trim().length > 0) {\n        chunks.push(currentChunk.trim());\n    }\n    return chunks;\n}\n\nconst textChunks = smartChunk(text, 2000, 100);\n\nreturn textChunks.map(c => ({\n    pageContent: c,\n    document_id: document_id,\n    metadata: {\n        filename: filename\n    }\n}));"
      },
